---
import Layout from "../layouts/Layout.astro";

const projects = [
  {
    number: "01",
    category: "TRANSPORTATION · ROUTE ENGINEERING",
    title: "TransJakarta Route Optimization",
    description:
      "Prototype route optimization using GTFS data, Dijkstra, and dual route preferences for public transportation.",
    tags: ["Laravel", "GTFS", "Dijkstra"],
    link: "https://simple-tj-4-deploy.wasmer.app/",
  },
  {
    number: "02",
    category: "AI · MOBILE APPLICATION",
    title: "AI Mental Health Application",
    description:
      "Mobile application combining AI interaction with an analytical dashboard for a more structured user experience.",
    tags: ["Kotlin", "Gemini API", "Data"],
  },
  {
    number: "03",
    category: "DATA · MACHINE LEARNING",
    title: "Data & Machine Learning Projects",
    description:
      "Selected work involving data analysis, machine learning workflows, visualization, and applied experimentation.",
    tags: ["Python", "Scikit-learn", "Analytics"],
  },
  {
    number: "04",
    category: "UI/UX · Mobile Application",
    title: "Food Application Delivery",
    description:
      "End-to-end mobile app design focused on streamlining the food ordering experience, featuring intuitive user flows, clean wireframes, and interactive prototyping.",
    tags: ["UI/UX Design", "Figma", "Prototyping", "User Research"],
    link: "https://www.figma.com/proto/jM2zCzuAXvulE19P0Kwl6A/LELE--Copy-?node-id=107-383&p=f&t=swFbAMOdPAeIHvez-0&scaling=scale-down&content-scaling=fixed&page-id=0%3A1&starting-point-node-id=107%3A633",
  },
];

const expertise = [
  {
    number: "01",
    title: "Software Engineering",
    description:
      "Building web and application solutions with an emphasis on structure, maintainability, and practical implementation.",
  },
  {
    number: "02",
    title: "Data & Analytics",
    description:
      "Working with data preparation, analysis, visualization, and data-driven problem solving.",
  },
  {
    number: "03",
    title: "AI & Machine Learning",
    description:
      "Exploring applied AI and machine learning through prototypes, experimentation, and practical applications.",
  },
  {
    number: "04",
    title: "Systems & Infrastructure",
    description:
      "Working with structured data, APIs, geospatial information, and transportation-related systems.",
  },
];
---

<Layout>
  <div class="site-shell">
    <header class="navbar">
      <a href="/" class="brand">MUHAMMAD REZA ADI PRATAMA</a>

      <nav class="nav-links" aria-label="Main navigation">
        <a href="#work">Work</a>
        <a href="#expertise">Expertise</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </nav>

      <a href="#contact" class="nav-contact">Let's talk <span>↗</span></a>
    </header>

    <main>
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">INFORMATICS GRADUATE · JAKARTA</p>

          <h1>
            Building Practical
            <span style="margin-top: 20px;">Digital Solutions.</span>
          </h1>

          <p class="hero-description">
            Software engineering, data, and AI <br />
            with a focus on turning technical ideas into practical, usable systems.
          </p>

          <div class="hero-actions">
            <a href="#work" class="button button-dark">
              Explore work
              <span>↓</span>
            </a>

            <a
              href="https://github.com/rezaaprm"
              class="button button-outline"
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub
              <span>↗</span>
            </a>
          </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="visual-grid"></div>

          <div class="visual-center">
            <div class="orbit orbit-one"></div>
            <div class="orbit orbit-two"></div>
            <div class="orbit orbit-three"></div>

            <div class="core">
              <span>R</span>
            </div>
          </div>

          <div class="visual-label label-top">SOFTWARE</div>
          <div class="visual-label label-right">DATA</div>
          <div class="visual-label label-bottom">AI</div>
          <div class="visual-label label-left">SYSTEMS</div>
        </div>
      </section>

      <section class="intro-strip">
        <p>
          A multidisciplinary approach to technology —
          <strong>from software development to data-driven systems.</strong>
        </p>
      </section>

      <section class="section" id="work">
        <div class="section-heading">
          <div>
            <p class="section-number">01 / SELECTED WORK</p>
            <h2>Projects that<br /><em>solve problems.</em></h2>
          </div>

          <p class="section-note">
            A selection of academic, personal, and applied technology work.
          </p>
        </div>

        <div class="projects">
          {
            projects.map((project) => (
              <article class="project-card">
                <div class="project-top">
                  <span>{project.number}</span>
                  <span>{project.category}</span>
                </div>

                <div class="project-content">
                  <div class="project-placeholder">
                    <div class="placeholder-lines">
                      <span />
                      <span />
                      <span />
                    </div>
                    <div class="placeholder-mark">↗</div>
                  </div>

                  <h3>{project.title}</h3>

                  <p>{project.description}</p>

                  <div class="tags">
                    {project.tags.map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </div>
                </div>

                <a
                  href={project.link}
                  class="project-footer"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>VIEW LIVE DEMO</span>
                  <span>↗</span>
                </a>
              </article>
            ))
          }
        </div>
      </section>

      <section class="dark-section" id="expertise">
        <div class="section-heading dark-heading">
          <div>
            <p class="section-number">02 / EXPERTISE</p>
            <h2>What I<br /><em>work with.</em></h2>
          </div>

          <p class="section-note">
            Technical interests shaped through academic work, projects, and
            hands-on experimentation.
          </p>
        </div>

        <div class="expertise-grid">
          {
            expertise.map((item) => (
              <article class="expertise-item">
                <span class="expertise-number">{item.number}</span>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </div>
                <span class="expertise-arrow">↗</span>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section experience-section">
        <div class="section-heading">
          <div>
            <p class="section-number">03 / EXPERIENCE</p>
            <h2>Where I've<br /><em>learned.</em></h2>
          </div>

          <p class="section-note">
            Selected experiences that shaped my approach to technology and
            problem solving.
          </p>
        </div>

        <div class="timeline">
          <article class="timeline-item">
            <div class="timeline-date">2025</div>
            <div class="timeline-main">
              <p class="timeline-type">INTERNSHIP</p>
              <h3>PT TASPEN (Persero)</h3>
              <p>
                Application Support Intern within the Information Technology
                division, working with internal applications and technology
                operations.
              </p>
            </div>
            <span class="timeline-arrow">↗</span>
          </article>

          <article class="timeline-item">
            <div class="timeline-date">2022 - 2026</div>
            <div class="timeline-main">
              <p class="timeline-type">EDUCATION</p>
              <h3>UPN "Veteran" Jakarta</h3>
              <p>
                Bachelor of Informatics with a focus across software
                development, data, artificial intelligence, and applied
                computing.
              </p>
            </div>
            <span class="timeline-arrow">↗</span>
          </article>
        </div>
      </section>

      <section class="about-section" id="about">
        <div class="about-label">
          <p class="section-number">04 / ABOUT</p>
        </div>

        <div class="about-content">
          <h2>
            Curious about technology,
            <span>focused on making it useful.</span>
          </h2>

          <p>
            I am an Informatics graduate interested in the intersection of
            software engineering, data, and artificial intelligence.
          </p>

          <p>
            My projects range from web applications and mobile applications to
            data analysis, machine learning, and transportation systems. I enjoy
            working on problems where technology needs to be both technically
            sound and practically useful.
          </p>
        </div>
      </section>

      <section class="contact-section" id="contact">
        <div>
          <p class="section-number">05 / CONTACT</p>
          <h2>Have an idea?<br /><em>Let's build.</em></h2>
        </div>

        <div class="contact-right">
          <p>
            Open to opportunities, collaborations, and interesting technology
            projects.
          </p>

          <a href="mailto:mhrezaaprm@gmail.com" class="contact-email">
            mhrezaaprm@gmail.com
            <span>↗</span>
          </a>

          <div class="social-links">
            <a
              href="https://github.com/rezaaprm"
              target="_blank"
              rel="noopener noreferrer">GitHub ↗</a
            >
            <a
              href="https://www.linkedin.com/in/muhammad-reza-adi-pratama/"
              target="_blank"
              rel="noopener noreferrer">LinkedIn ↗</a
            >
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <span>© 2026 M. REZA ADI PRATAMA</span>
      <span>DESIGNED & BUILT WITH ASTRO</span>
    </footer>
  </div>
</Layout>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f5f3ee;
    color: #171717;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .site-shell {
    min-height: 100vh;
    overflow: hidden;
  }

  .navbar {
    width: min(1440px, calc(100% - 64px));
    margin: 0 auto;
    height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #d9d6ce;
  }

  .brand {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .nav-links {
    display: flex;
    gap: 34px;
    font-size: 12px;
    color: #66645f;
  }

  .nav-links a,
  .nav-contact {
    transition: color 180ms ease;
  }

  .nav-links a:hover,
  .nav-contact:hover {
    color: #171717;
  }

  .nav-contact {
    font-size: 12px;
    font-weight: 600;
  }

  .nav-contact span {
    margin-left: 5px;
  }

  .hero {
    width: min(1440px, calc(100% - 64px));
    min-height: 680px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 60px;
    align-items: center;
  }

  .hero-copy {
    padding: 80px 0;
  }

  .eyebrow,
  .section-number,
  .timeline-type {
    margin: 0 0 24px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #77736b;
  }

  .hero h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(58px, 7vw, 108px);
    line-height: 0.91;
    letter-spacing: -0.065em;
    font-weight: 600;
  }

  .hero h1 span {
    display: block;
    color: #77736b;
  }

  .hero-description {
    max-width: 540px;
    margin: 42px 0 0;
    font-size: 17px;
    line-height: 1.7;
    color: #66645f;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    margin-top: 34px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    min-height: 48px;
    padding: 0 18px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition:
      transform 180ms ease,
      background 180ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-dark {
    background: #171717;
    color: #f5f3ee;
  }

  .button-outline {
    border: 1px solid #c8c4bb;
  }

  .hero-visual {
    position: relative;
    height: 520px;
    background: #e8e3d7;
    overflow: hidden;
  }

  .visual-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(#d3cfc5 1px, transparent 1px),
      linear-gradient(90deg, #d3cfc5 1px, transparent 1px);
    background-size: 52px 52px;
    opacity: 0.55;
  }

  .visual-center {
    position: absolute;
    inset: 50%;
    width: 300px;
    height: 300px;
    transform: translate(-50%, -50%);
  }

  .orbit {
    position: absolute;
    inset: 50%;
    border: 1px solid #9d988e;
    transform: translate(-50%, -50%);
    border-radius: 50%;
  }

  .orbit-one {
    width: 140px;
    height: 140px;
  }

  .orbit-two {
    width: 220px;
    height: 220px;
  }

  .orbit-three {
    width: 300px;
    height: 300px;
  }

  .core {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 76px;
    height: 76px;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    background: #171717;
    color: #f5f3ee;
    font-size: 26px;
    font-weight: 600;
    border-radius: 50%;
  }

  .visual-label {
    position: absolute;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #77736b;
  }

  .label-top {
    top: 26px;
    left: 50%;
    transform: translateX(-50%);
  }

  .label-right {
    top: 50%;
    right: 26px;
    transform: translateY(-50%);
  }

  .label-bottom {
    bottom: 26px;
    left: 50%;
    transform: translateX(-50%);
  }

  .label-left {
    top: 50%;
    left: 26px;
    transform: translateY(-50%);
  }

  .intro-strip {
    border-top: 1px solid #d9d6ce;
    border-bottom: 1px solid #d9d6ce;
    padding: 30px 32px;
  }

  .intro-strip p {
    max-width: 1440px;
    margin: 0 auto;
    font-size: 14px;
    line-height: 1.6;
    color: #77736b;
  }

  .intro-strip strong {
    color: #171717;
    font-weight: 500;
  }

  .section {
    width: min(1440px, calc(100% - 64px));
    margin: 0 auto;
    padding: 140px 0;
  }

  .section-heading {
    display: grid;
    grid-template-columns: 1fr 0.7fr;
    gap: 60px;
    align-items: end;
    margin-bottom: 70px;
  }

  .section-heading h2,
  .contact-section h2 {
    margin: 0;
    font-size: clamp(48px, 5.5vw, 82px);
    line-height: 0.94;
    letter-spacing: -0.055em;
    font-weight: 500;
  }

  .section-heading h2 em,
  .contact-section h2 em {
    color: #77736b;
    font-style: normal;
  }

  .section-note {
    max-width: 390px;
    margin: 0 0 5px auto;
    font-size: 14px;
    line-height: 1.7;
    color: #77736b;
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .project-card {
    border: 1px solid #d9d6ce;
    background: #fff;
    transition:
      transform 220ms ease,
      border-color 220ms ease;
  }

  .project-card:hover {
    transform: translateY(-5px);
    border-color: #a8a39a;
  }

  .project-top {
    display: flex;
    justify-content: space-between;
    padding: 17px 18px;
    border-bottom: 1px solid #e5e2db;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #8a867e;
  }

  .project-content {
    padding: 16px;
  }

  .project-placeholder {
    position: relative;
    height: 230px;
    margin-bottom: 26px;
    background: #e8e3d7;
    overflow: hidden;
  }

  .placeholder-lines {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 45%;
    transform: translate(-50%, -50%);
  }

  .placeholder-lines span {
    display: block;
    height: 1px;
    margin: 10px 0;
    background: #77736b;
  }

  .placeholder-mark {
    position: absolute;
    right: 16px;
    bottom: 13px;
    font-size: 28px;
    color: #77736b;
  }

  .project-content h3 {
    margin: 0;
    font-size: 23px;
    line-height: 1.1;
    letter-spacing: -0.025em;
    font-weight: 600;
  }

  .project-content p {
    margin: 16px 0 20px;
    font-size: 13px;
    line-height: 1.65;
    color: #77736b;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tags span {
    padding: 6px 9px;
    border: 1px solid #d9d6ce;
    font-size: 9px;
    font-weight: 600;
    color: #77736b;
  }

  .project-footer {
    display: flex;
    justify-content: space-between;
    padding: 17px 18px;
    border-top: 1px solid #e5e2db;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .dark-section {
    padding: 140px max(32px, calc((100vw - 1440px) / 2));
    background: #171717;
    color: #f5f3ee;
  }

  .dark-heading {
    width: 100%;
    max-width: 1440px;
    margin-right: auto;
    margin-left: auto;
  }

  .dark-heading .section-number,
  .dark-heading .section-note {
    color: #8d8980;
  }

  .dark-heading h2 em {
    color: #8d8980;
  }

  .expertise-grid {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    border-top: 1px solid #393837;
  }

  .expertise-item {
    display: grid;
    grid-template-columns: 70px 1fr 30px;
    gap: 30px;
    align-items: center;
    padding: 29px 0;
    border-bottom: 1px solid #393837;
  }

  .expertise-number {
    font-size: 10px;
    color: #77736b;
  }

  .expertise-item h3 {
    margin: 0 0 7px;
    font-size: 21px;
    font-weight: 500;
  }

  .expertise-item p {
    max-width: 650px;
    margin: 0;
    font-size: 13px;
    line-height: 1.65;
    color: #99958d;
  }

  .expertise-arrow {
    font-size: 18px;
    color: #8d8980;
  }

  .experience-section {
    padding-bottom: 130px;
  }

  .timeline {
    border-top: 1px solid #d9d6ce;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 150px 1fr 30px;
    gap: 40px;
    padding: 38px 0;
    border-bottom: 1px solid #d9d6ce;
  }

  .timeline-date {
    font-size: 11px;
    font-weight: 600;
    color: #77736b;
  }

  .timeline-type {
    margin-bottom: 9px;
  }

  .timeline-main h3 {
    margin: 0 0 11px;
    font-size: 25px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .timeline-main > p:last-child {
    max-width: 700px;
    margin: 0;
    font-size: 13px;
    line-height: 1.7;
    color: #77736b;
  }

  .timeline-arrow {
    align-self: center;
    font-size: 18px;
    color: #77736b;
  }

  .about-section {
    display: grid;
    grid-template-columns: 0.4fr 1fr;
    gap: 80px;
    padding: 140px max(32px, calc((100vw - 1440px) / 2));
    background: #e8e3d7;
  }

  .about-content {
    max-width: 900px;
  }

  .about-content h2 {
    margin: 0 0 45px;
    font-size: clamp(42px, 5vw, 76px);
    line-height: 0.98;
    letter-spacing: -0.055em;
    font-weight: 500;
  }

  .about-content h2 span {
    color: #77736b;
  }

  .about-content p {
    max-width: 720px;
    margin: 0 0 18px;
    font-size: 16px;
    line-height: 1.75;
    color: #5e5b55;
  }

  .contact-section {
    width: min(1440px, calc(100% - 64px));
    margin: 0 auto;
    padding: 150px 0;
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    gap: 80px;
  }

  .contact-right {
    align-self: end;
  }

  .contact-right > p {
    max-width: 420px;
    margin: 0 0 35px;
    font-size: 14px;
    line-height: 1.7;
    color: #77736b;
  }

  .contact-email {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 15px;
    border-bottom: 1px solid #171717;
    font-size: 18px;
    font-weight: 500;
  }

  .social-links {
    display: flex;
    gap: 25px;
    margin-top: 25px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer {
    width: min(1440px, calc(100% - 64px));
    margin: 0 auto;
    padding: 24px 0;
    border-top: 1px solid #d9d6ce;
    display: flex;
    justify-content: space-between;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #8a867e;
  }

  @media (max-width: 900px) {
    .navbar,
    .hero,
    .section,
    .contact-section,
    .footer {
      width: min(100% - 40px, 700px);
    }

    .nav-links {
      display: none;
    }

    .hero {
      grid-template-columns: 1fr;
      padding: 55px 0 70px;
    }

    .hero-copy {
      padding: 20px 0;
    }

    .hero-visual {
      height: 420px;
    }

    .section-heading,
    .contact-section {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .section-note {
      margin-left: 0;
    }

    .projects {
      grid-template-columns: 1fr;
    }

    .project-placeholder {
      height: 280px;
    }

    .about-section {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 100px 20px;
    }

    .timeline-item {
      grid-template-columns: 100px 1fr;
    }

    .timeline-arrow {
      display: none;
    }

    .dark-section {
      padding: 100px 20px;
    }
  }

  @media (max-width: 560px) {
    .navbar {
      height: 72px;
